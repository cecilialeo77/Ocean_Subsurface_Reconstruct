# Track source code, tests, configuration, and documentation.
# Keep datasets and generated experiment artifacts local.

# Dataset directories (root-level, preserving src/**/data.py)
/data/
/dataset/
/datasets/
/raw_data/
/processed_data/
/surface/
/subsurface/

# Scientific data and reconstruction outputs
*.nc
*.nc4
*.netcdf
*.h5
*.hdf5
*.hdf
*.npy
*.npz
*.mat
*.zarr/
*.parquet
*.pkl
*.pickle

# Generated training, evaluation, and prediction directories
outputs/
output/
results/
checkpoints/
weights/
artifacts/

# Model weights and exported models
*.pt
*.pth
*.pth.tar
*.ckpt
*.safetensors
*.onnx
