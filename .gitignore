*.tflite

# Training logs and experiment trackers
logs/
log/
runs/
wandb/
mlruns/
lightning_logs/
tensorboard/
*.log
*.log.*
events.out.tfevents.*
history.json
initialization.json
metrics_*.json
metrics_*.csv
metrics_*.tsv

# Python bytecode and tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Virtual environments and generated packaging files
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
*.egg

# Local environment variables and editor/OS files
.env
.env.*
!.env.example
!.env.template
